# Copy this file to .env and fill in the MySQL connection values.
# The database must already exist; the API creates the users table at startup.
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_USER=your-database-user
MYSQL_PASSWORD=your-database-password
MYSQL_DATABASE=your-database-name

# Set a random value (32+ characters) and use https_only=true in hosted HTTPS environments.
TTFIT_SESSION_SECRET=replace-with-a-long-random-secret
TTFIT_HTTPS_ONLY=false
